<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Gitalk.in | Flowers & Tourism</title>

<meta name="description"
content="Gitalk.in - Explore beautiful flowers, tourism destinations and travel booking.">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f7faf8;
    color:#333;
    line-height:1.6;
}

/* HEADER */
header{
    position:sticky;
    top:0;
    z-index:1000;
    background:white;
    box-shadow:0 2px 12px rgba(0,0,0,.12);
    padding:15px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:28px;
    font-weight:bold;
    color:#159447;
}

.logo span{
    color:#e91e63;
}

nav{
    display:flex;
    gap:22px;
}

nav a{
    text-decoration:none;
    color:#333;
    font-weight:bold;
}

nav a:hover{
    color:#159447;
}

.menu{
    display:none;
    font-size:28px;
    cursor:pointer;
}

/* HERO */
.hero{
    min-height:650px;
    background:
    linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),
    url("images/tourism1.jpg") center/cover no-repeat;

    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:white;
    padding:30px;
}

.hero h1{
    font-size:58px;
}

.hero p{
    font-size:23px;
    margin:15px 0 30px;
}

.btn{
    display:inline-block;
    background:#159447;
    color:white;
    padding:13px 28px;
    border-radius:6px;
    text-decoration:none;
    border:0;
    cursor:pointer;
    font-size:16px;
}

.btn:hover{
    background:#0c7135;
}

/* SECTIONS */
section{
    padding:75px 6%;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title h2{
    color:#159447;
    font-size:38px;
}

.section-title p{
    color:#666;
}

/* ABOUT */
.about{
    max-width:950px;
    margin:auto;
    text-align:center;
}

.about h3{
    color:#159447;
    font-size:25px;
    margin:20px 0 10px;
}

/* CARDS */
.cards{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.card{
    background:white;
    border-radius:12px;
    overflow:hidden;
    box-shadow:0 4px 18px rgba(0,0,0,.1);
    text-align:center;
    padding-bottom:25px;
    transition:.3s;
}

.card:hover{
    transform:translateY(-5px);
}

.card img{
    width:100%;
    height:240px;
    object-fit:cover;
}

.card h3{
    color:#159447;
    margin:15px 0 8px;
}

.card p{
    padding:0 20px;
    margin-bottom:12px;
}

/* TOURISM */
.tourism{
    background:#eef8f1;
}

/* BOOKING */
.booking-box{
    max-width:700px;
    margin:auto;
}

form{
    background:white;
    padding:35px;
    border-radius:12px;
    box-shadow:0 4px 20px rgba(0,0,0,.1);
}

label{
    display:block;
    font-weight:bold;
    margin:14px 0 6px;
}

input,textarea,select{
    width:100%;
    padding:13px;
    border:1px solid #ccc;
    border-radius:6px;
    font-size:16px;
}

input:focus,
textarea:focus,
select:focus{
    outline:none;
    border-color:#159447;
}

/* CONTACT */
.contact{
    background:#eef8f1;
}

.contact-info{
    max-width:700px;
    margin:auto;
    text-align:center;
}

.contact-info p{
    margin:10px 0;
    font-size:18px;
}

/* FOOTER */
footer{
    background:#222;
    color:white;
    text-align:center;
    padding:30px 20px;
}

footer strong{
    color:#63c174;
}

/* MOBILE */
@media(max-width:768px){

    header{
        padding:14px 20px;
    }

    .menu{
        display:block;
    }

    nav{
        display:none;
        position:absolute;
        top:65px;
        left:0;
        width:100%;
        background:white;
        flex-direction:column;
        gap:0;
    }

    nav.active{
        display:flex;
    }

    nav a{
        padding:14px 25px;
        border-bottom:1px solid #eee;
    }

    .hero{
        min-height:520px;
    }

    .hero h1{
        font-size:40px;
    }

    .hero p{
        font-size:18px;
    }

    .cards{
        grid-template-columns:1fr;
    }

    section{
        padding:55px 20px;
    }
}
</style>
</head>

<body>

<!-- HEADER -->
<header>

    <div class="logo">
        Gitalk<span>.in</span>
    </div>

    <div class="menu" onclick="toggleMenu()">☰</div>

    <nav id="nav">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#flowers">Flowers</a>
        <a href="#tourism">Tourism</a>
        <a href="#booking">Booking</a>
        <a href="#contact">Contact</a>
    </nav>

</header>


<!-- HOME -->
<section id="home" class="hero">

    <div>

        <h1>Welcome to Gitalk.in</h1>

        <p>
            Discover Beautiful Flowers,
            Amazing Places & Travel
        </p>

        <a href="#tourism" class="btn">
            Explore Now
        </a>

    </div>

</section>


<!-- ABOUT -->
<section id="about">

    <div class="section-title">

        <h2>About Gitalk.in</h2>

        <p>Explore • Travel • Enjoy</p>

    </div>

    <div class="about">

        <p>
            Welcome to <strong>Gitalk.in</strong>, your online destination
            for beautiful flowers, nature and tourism.
        </p>

        <h3>Our Vision</h3>

        <p>
            We want to bring beautiful nature, interesting destinations
            and travel information together in one simple website.
        </p>

    </div>

</section>


<!-- FLOWERS -->
<section id="flowers">

    <div class="section-title">

        <h2>🌸 Beautiful Flowers</h2>

        <p>Explore the beauty of nature</p>

    </div>

    <div class="cards">

        <div class="card">

            <img src="images/flower1.jpg" alt="Rose">

            <h3>🌹 Rose</h3>

            <p>
                One of the world's most popular and beautiful flowers.
            </p>

        </div>


        <div class="card">

            <img src="images/flower2.jpg" alt="Tulip">

            <h3>🌷 Tulip</h3>

            <p>
                Colourful flowers that brighten gardens and landscapes.
            </p>

        </div>


        <div class="card">

            <img src="images/flower3.jpg" alt="Lotus">

            <h3>🪷 Lotus</h3>

            <p>
                A beautiful water flower associated with purity and nature.
            </p>

        </div>

    </div>

</section>


<!-- TOURISM -->
<section id="tourism" class="tourism">

    <div class="section-title">

        <h2>🌍 Tourism</h2>

        <p>Discover beautiful destinations</p>

    </div>

    <div class="cards">

        <div class="card">

            <img src="images/tourism1.jpg" alt="Mountain">

            <h3>🏔️ Mountain Tours</h3>

            <p>
                Enjoy beautiful mountains and peaceful natural surroundings.
            </p>

            <a href="#booking" class="btn">
                Plan Trip
            </a>

        </div>


        <div class="card">

            <img src="images/tourism2.jpg" alt="Beach">

            <h3>🏖️ Beach Holidays</h3>

            <p>
                Relax and enjoy beautiful beaches and unforgettable views.
            </p>

            <a href="#booking" class="btn">
                Plan Trip
            </a>

        </div>


        <div class="card">

            <img src="images/tourism3.jpg" alt="Nature">

            <h3>🌳 Nature Travel</h3>

            <p>
                Discover forests, waterfalls and beautiful natural places.
            </p>

            <a href="#booking" class="btn">
                Plan Trip
            </a>

        </div>

    </div>

</section>


<!-- BOOKING -->
<section id="booking">

    <div class="section-title">

        <h2>📅 Booking</h2>

        <p>Send us your travel requirements</p>

    </div>

    <div class="booking-box">

        <form onsubmit="booking(event)">

            <label>Name</label>

            <input
                type="text"
                id="name"
                placeholder="Enter your name"
                required
            >


            <label>Mobile Number</label>

            <input
                type="tel"
                id="mobile"
                placeholder="Enter mobile number"
                required
            >


            <label>Email</label>

            <input
                type="email"
                id="email"
                placeholder="Enter email"
            >


            <label>Destination</label>

            <input
                type="text"
                id="destination"
                placeholder="Where do you want to go?"
                required
            >


            <label>Travel Date</label>

            <input
                type="date"
                id="date"
                required
            >


            <label>Number of People</label>

            <input
                type="number"
                id="people"
                min="1"
                value="1"
                required
            >


            <label>Message</label>

            <textarea
                id="message"
                rows="5"
                placeholder="Your requirements..."
            ></textarea>


            <br><br>

            <button class="btn" type="submit">
                Submit Booking
            </button>

        </form>

    </div>

</section>


<!-- CONTACT -->
<section id="contact" class="contact">

    <div class="section-title">

        <h2>📞 Contact Us</h2>

        <p>We would love to hear from you</p>

    </div>

    <div class="contact-info">

        <p>🌐 Website: <strong>Gitalk.in</strong></p>

        <p>📧 Email: your-email@example.com</p>

        <p>📱 Mobile: +91 XXXXX XXXXX</p>

        <br>

        <a
            href="https://wa.me/91XXXXXXXXXX"
            class="btn"
            target="_blank"
        >
            💬 WhatsApp Us
        </a>

    </div>

</section>


<!-- FOOTER -->
<footer>

    <p>
        © 2026 <strong>Gitalk.in</strong>
        | All Rights Reserved
    </p>

    <p>
        Flowers • Tourism • Travel
    </p>

</footer>


<script>

function toggleMenu(){

    document
    .getElementById("nav")
    .classList
    .toggle("active");

}


function booking(event){

    event.preventDefault();

    const name =
        document.getElementById("name").value;

    const mobile =
        document.getElementById("mobile").value;

    const destination =
        document.getElementById("destination").value;

    const date =
        document.getElementById("date").value;

    const people =
        document.getElementById("people").value;

    const message =
        document.getElementById("message").value;


    /*
      Replace this number with your WhatsApp number.

      Example:
      919876543210

      Do NOT use + or spaces.
    */

    const whatsappNumber =
        "91XXXXXXXXXX";


    const text =
        "🌍 Gitalk.in Booking Request%0A%0A" +
        "Name: " + encodeURIComponent(name) +
        "%0AMobile: " + encodeURIComponent(mobile) +
        "%0ADestination: " + encodeURIComponent(destination) +
        "%0ATravel Date: " + encodeURIComponent(date) +
        "%0APeople: " + encodeURIComponent(people) +
        "%0AMessage: " + encodeURIComponent(message);


    if(whatsappNumber.includes("X")){

        alert(
            "Booking form is working! " +
            "Please add your WhatsApp number in the code."
        );

        return;

    }


    window.open(
        "https://wa.me/" +
        whatsappNumber +
        "?text=" +
        text,
        "_blank"
    );

}

</script>

</body>
</html>
