<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gitalk Social</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:linear-gradient(135deg,#078cf0,#00c99a);min-height:100vh;color:#222}
.wrap{max-width:760px;margin:auto;padding:12px}
.card{background:#fff;border-radius:24px;padding:20px;margin:10px 0;box-shadow:0 8px 30px #0002}
header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ddd;padding-bottom:14px}
.logo{font-size:38px;font-weight:800;color:#087fe5}
button{border:0;border-radius:12px;padding:11px 16px;font-size:15px;font-weight:700;cursor:pointer}
.primary{background:#087fe5;color:#fff}.dark{background:#222;color:#fff}.light{background:#eef3f8}
input{width:100%;padding:14px;border:1px solid #ccc;border-radius:12px;font-size:16px;margin:6px 0}
h2{margin:8px 0 14px}.hidden{display:none!important}
.msg{padding:11px;border-radius:10px;margin:10px 0;background:#f2f5f9}.ok{color:#087c45}.err{color:#c00}
.row{display:flex;gap:8px;align-items:center;padding:11px 0;border-bottom:1px solid #eee}
.userinfo{display:flex;gap:10px;align-items:center;flex:1;min-width:0}
.avatar{width:48px;height:48px;min-width:48px;border-radius:50%;background:#087fe5;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:20px}
.small{font-size:13px;color:#666}
nav{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:15px 0}
nav button{padding:10px 3px;font-size:13px}
#chatBox{height:330px;overflow:auto;border:1px solid #ddd;border-radius:14px;padding:10px;background:#fafafa}
.bubble{max-width:80%;padding:10px 13px;border-radius:15px;margin:7px 0;word-wrap:break-word}
.mine{background:#087fe5;color:#fff;margin-left:auto}.theirs{background:#e9edf2}
.media-row{display:flex;gap:10px;align-items:center;margin-top:10px;flex-wrap:wrap}.media-btn{display:inline-block;background:#eef3f8;color:#222;padding:11px 14px;border-radius:12px;font-weight:700;cursor:pointer}.media-preview{max-width:100%;max-height:180px;border-radius:12px;margin-top:8px}.chat-media{max-width:220px;max-height:220px;border-radius:12px;display:block;margin-top:4px}@media(max-width:500px){.wrap{padding:8px}.logo{font-size:32px}.card{padding:16px}nav button{font-size:12px}.chat-media{max-width:190px}}

textarea{width:100%;padding:14px;border:1px solid #ccc;border-radius:12px;font-size:16px;resize:vertical;font-family:Arial,sans-serif;margin:6px 0}
.post-create{background:#f7f9fb;border-radius:16px;padding:14px;margin:10px 0 18px}
.post{border:1px solid #e1e5ea;border-radius:16px;padding:14px;margin:12px 0;background:#fff}
.post-head{display:flex;align-items:center;gap:10px}
.post-avatar{width:42px;height:42px;border-radius:50%;background:#087fe5;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold}
.post-media{width:100%;max-height:430px;object-fit:contain;border-radius:12px;margin-top:10px;background:#f2f5f9}
.post-actions{display:flex;gap:7px;margin-top:10px;flex-wrap:wrap}
.post-actions button{background:#eef3f8;padding:8px 12px}
.comment-box{display:flex;gap:6px;margin-top:10px}
.comment-box input{margin:0}
.comments{margin-top:8px}
.comment{background:#f2f5f9;padding:7px 10px;border-radius:10px;margin:5px 0}
</style>
</head>
<body>
<div class="wrap">

<div id="auth" class="card">
  <div style="text-align:center;margin:10px 0 25px">
    <div class="logo">Gitalk</div>
    <p style="font-size:18px;color:#666">Social Network</p>
  </div>

  <div id="loginBox">
    <h2>Login</h2>
    <input id="loginEmail" type="email" placeholder="Email">
    <input id="loginPassword" type="password" placeholder="Password">
    <button class="primary" style="width:100%" onclick="login()">Login</button>
    <p style="text-align:center;margin-top:15px">New user?
      <button class="light" onclick="toggleAuth()">Create Account</button>
    </p>
  </div>

  <div id="registerBox" class="hidden">
    <h2>Create Account</h2>
    <input id="regName" placeholder="Full name">
    <input id="regUsername" placeholder="Username">
    <input id="regEmail" type="email" placeholder="Email">
    <input id="regPassword" type="password" placeholder="Password (6+ characters)">
    <button class="primary" style="width:100%" onclick="register()">Create Account</button>
    <p style="text-align:center;margin-top:15px">
      <button class="light" onclick="toggleAuth()">← Back to Login</button>
    </p>
  </div>
  <div id="authMsg"></div>
</div>

<div id="app" class="hidden">
<div class="card">
<header>
  <div class="logo">Gitalk</div>
  <button class="dark" onclick="logout()">Logout</button>
</header>

<nav>
  <button class="light" onclick="show('home')">🏠 Home</button>
  <button class="light" onclick="show('profile')">👤 Profile</button>
  <button class="light" onclick="show('search')">🔎 Search</button>
  <button class="light" onclick="show('friends')">👥 Friends</button>
  <button class="light" onclick="show('posts');loadPosts()">📰 Posts</button>
</nav>

<section id="home">
  <h2>Welcome, <span id="homeName"></span> ❤️</h2>
  <p class="small">Your Gitalk Social account is connected.</p>
  <div class="msg ok">Login and Supabase connection are working.</div>
</section>

<section id="profile" class="hidden">
  <h2>👤 Profile Settings</h2>
  <input id="profileName" placeholder="Full name">
  <input id="profileUsername" placeholder="Username">
  <input id="profileBio" placeholder="Bio">
  <button class="primary" onclick="saveProfile()">Save Profile</button>
  <div id="profileMsg"></div>
</section>

<section id="search" class="hidden">
  <h2>🔎 Search Users</h2>
  <input id="searchInput" placeholder="Search name or username">
  <button class="primary" onclick="searchUsers()">Search</button>
  <div id="searchResults"></div>
</section>

<section id="friends" class="hidden">
  <h2>🤝 Friend Requests</h2>
  <div id="requests"></div>
  <h2 style="margin-top:22px">👥 My Friends</h2>
  <div id="friendsList"></div>
</section>

<section id="posts" class="hidden">
  <h2>📰 Gitalk Social Feed</h2>
  <div class="post-create">
    <textarea id="postText" placeholder="What's on your mind?" rows="3"></textarea>
    <div class="media-row">
      <label class="media-btn">📷 Photo / 🎥 Video
        <input id="postMedia" type="file" accept="image/*,video/*" onchange="previewPostMedia()" hidden>
      </label>
      <span id="postMediaName" class="small">No file selected</span>
    </div>
    <div id="postPreview"></div>
    <button class="primary" onclick="createPost()">🚀 Post</button>
  </div>
  <div id="postsFeed"></div>
</section>

<section id="chat" class="hidden">
  <h2>💬 <span id="chatName"></span></h2>
  <div id="chatBox"></div>
  <div style="display:flex;gap:7px;margin-top:8px;align-items:stretch">
    <input id="messageInput" placeholder="Write a message..."
      onkeydown="if(event.key==='Enter')sendMessage()">
    <button class="primary" onclick="sendMessage()">Send</button>
  </div>
  <div class="media-row">
    <label class="media-btn">📷 Photo / 🎥 Video
      <input id="mediaInput" type="file" accept="image/*,video/*" onchange="previewMedia()" hidden>
    </label>
    <span id="mediaName" class="small">No file selected</span>
  </div>
  <div id="mediaPreview"></div>
  <button class="light" style="margin-top:10px" onclick="show('friends')">← Friends</button>
</section>

</div>
</div>
</div>

<script>
const SUPABASE_URL="https://mhnfutbpvyvhdmqqquyi.supabase.co";
const SUPABASE_KEY="sb_publishable_NpULKcoHIfa0urWJH0oOPA_o9vqamOl";
const supabaseClient=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

let currentUser=null,currentProfile=null,chatUser=null,chatChannel=null;

function $(id){return document.getElementById(id)}
function escapeHTML(s){
 return String(s??"").replace(/[&<>"']/g,m=>({
 "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
 }[m]));
}
function setMsg(id,text,good=false){
 $(id).innerHTML='<div class="msg '+(good?'ok':'err')+'">'+escapeHTML(text)+'</div>';
}
function toggleAuth(){
 $("loginBox").classList.toggle("hidden");
 $("registerBox").classList.toggle("hidden");
 $("authMsg").innerHTML="";
}

async function register(){
 const email=$("regEmail").value.trim();
 const password=$("regPassword").value;
 const username=$("regUsername").value.trim().toLowerCase();
 const name=$("regName").value.trim();

 if(!email||!password||!username){setMsg("authMsg","Please fill all required fields.");return}
 if(password.length<6){setMsg("authMsg","Password must be at least 6 characters.");return}

 const {data,error}=await supabaseClient.auth.signUp({
   email,password,
   options:{data:{username,full_name:name}}
 });
 if(error){setMsg("authMsg",error.message);return}

 if(data.session && data.user){
   currentUser=data.user;
   const {error:e}=await supabaseClient.from("profiles").upsert({
     id:data.user.id,username,full_name:name
   });
   if(e){setMsg("authMsg",e.message);return}
   await loadSession();
 }else{
   setMsg("authMsg","Account created. Confirm your email, then login.",true);
 }
}

async function login(){
 const email=$("loginEmail").value.trim();
 const password=$("loginPassword").value;
 if(!email||!password){setMsg("authMsg","Enter email and password.");return}

 const {data,error}=await supabaseClient.auth.signInWithPassword({email,password});
 if(error){setMsg("authMsg",error.message);return}

 currentUser=data.user;
 await loadSession();
}

async function loadSession(){
 if(!currentUser){
   const {data:{user}}=await supabaseClient.auth.getUser();
   currentUser=user;
 }
 if(!currentUser)return;

 await ensureProfile();

 $("auth").classList.add("hidden");
 $("app").classList.remove("hidden");
 $("homeName").textContent=currentProfile.full_name||currentProfile.username||currentUser.email;
 show("home");
}

async function ensureProfile(){
 let {data,error}=await supabaseClient.from("profiles")
   .select("*").eq("id",currentUser.id).maybeSingle();

 if(error){console.error(error);return}

 if(!data){
   let base=(currentUser.user_metadata?.username ||
             currentUser.email?.split("@")[0] || "user")
             .toLowerCase().replace(/[^a-z0-9_]/g,"").slice(0,25);
   if(!base)base="user";

   let username=base;
   const {data:existing}=await supabaseClient.from("profiles")
     .select("id").eq("username",username).limit(1);

   if(existing?.length)username=base+"_"+currentUser.id.slice(0,5);

   const {data:newProfile,error:e}=await supabaseClient.from("profiles").insert({
     id:currentUser.id,
     username,
     full_name:currentUser.user_metadata?.full_name || currentUser.email?.split("@")[0] || "Gitalk User"
   }).select().single();

   if(!e)data=newProfile;
   else console.error(e);
 }
 currentProfile=data||null;

 if(currentProfile){
   $("profileName").value=currentProfile.full_name||"";
   $("profileUsername").value=currentProfile.username||"";
   $("profileBio").value=currentProfile.bio||"";
 }
}

async function saveProfile(){
 const username=$("profileUsername").value.trim().toLowerCase();
 const name=$("profileName").value.trim();
 const bio=$("profileBio").value.trim();

 if(!username){setMsg("profileMsg","Username is required.");return}

 const {error}=await supabaseClient.from("profiles").upsert({
   id:currentUser.id,username,full_name:name,bio
 });

 if(error){setMsg("profileMsg",error.message);return}

 await ensureProfile();
 $("homeName").textContent=currentProfile?.full_name||currentProfile?.username||"Friend";
 setMsg("profileMsg","Profile saved successfully ❤️",true);
}

async function searchUsers(){
 const q=$("searchInput").value.trim();
 if(!q){$("searchResults").innerHTML='<div class="msg">Enter a name or username.</div>';return}

 const safe=q.replace(/[%_,]/g,"");
 const {data,error}=await supabaseClient.from("profiles")
   .select("id,username,full_name,bio")
   .neq("id",currentUser.id)
   .or("username.ilike.%"+safe+"%,full_name.ilike.%"+safe+"%")
   .limit(20);

 if(error){
   $("searchResults").innerHTML='<div class="msg err">'+escapeHTML(error.message)+'</div>';
   return;
 }
 if(!data?.length){
   $("searchResults").innerHTML='<div class="msg">No users found.</div>';
   return;
 }

 $("searchResults").innerHTML=data.map(u=>`
 <div class="row">
  <div class="userinfo">
   <div class="avatar">${escapeHTML((u.full_name||u.username||"?")[0].toUpperCase())}</div>
   <div><b>${escapeHTML(u.full_name||u.username)}</b><br>
   <span class="small">@${escapeHTML(u.username)}</span></div>
  </div>
  <button class="primary" onclick="addFriend('${u.id}')">Add Friend</button>
 </div>`).join("");
}

async function addFriend(id){
 const {data:existing,error:e}=await supabaseClient.from("friendships")
   .select("*")
   .or("and(requester_id.eq."+currentUser.id+",addressee_id.eq."+id+"),and(requester_id.eq."+id+",addressee_id.eq."+currentUser.id+")");

 if(e){alert(e.message);return}
 if(existing?.some(x=>x.status==="accepted")){alert("Already friends.");return}
 if(existing?.some(x=>x.status==="pending")){alert("Friend request already exists.");return}

 const {error}=await supabaseClient.from("friendships").insert({
   requester_id:currentUser.id,addressee_id:id,status:"pending"
 });
 alert(error?"Error: "+error.message:"Friend request sent ❤️");
}

async function loadFriends(){
 const {data:req,error:re}=await supabaseClient.from("friendships")
   .select("*").eq("addressee_id",currentUser.id).eq("status","pending");

 if(re){$("requests").innerHTML='<div class="msg err">'+escapeHTML(re.message)+'</div>';}
 else if(req?.length){
   const ids=req.map(x=>x.requester_id);
   const {data:users}=await supabaseClient.from("profiles").select("*").in("id",ids);
   $("requests").innerHTML=(users||[]).map(u=>`
    <div class="row">
     <div class="userinfo"><div class="avatar">${escapeHTML((u.full_name||u.username)[0].toUpperCase())}</div>
     <div><b>${escapeHTML(u.full_name||u.username)}</b><br>
     <span class="small">@${escapeHTML(u.username)}</span></div></div>
     <button class="primary" onclick="acceptRequest('${u.id}')">Accept</button>
     <button class="light" onclick="rejectRequest('${u.id}')">Reject</button>
    </div>`).join("");
 }else{
   $("requests").innerHTML='<div class="msg">No pending requests.</div>';
 }

 const {data:sent}=await supabaseClient.from("friendships").select("*")
   .eq("requester_id",currentUser.id).eq("status","accepted");
 const {data:received}=await supabaseClient.from("friendships").select("*")
   .eq("addressee_id",currentUser.id).eq("status","accepted");

 const ids=[
   ...(sent||[]).map(x=>x.addressee_id),
   ...(received||[]).map(x=>x.requester_id)
 ];
 const unique=[...new Set(ids)];

 if(!unique.length){
   $("friendsList").innerHTML='<div class="msg">No friends yet. Search and add friends.</div>';
   return;
 }

 const {data:users,error}=await supabaseClient.from("profiles").select("*").in("id",unique);
 if(error){$("friendsList").innerHTML='<div class="msg err">'+escapeHTML(error.message)+'</div>';return}

 $("friendsList").innerHTML=(users||[]).map(u=>`
 <div class="row">
  <div class="userinfo">
   <div class="avatar">${escapeHTML((u.full_name||u.username)[0].toUpperCase())}</div>
   <div><b>${escapeHTML(u.full_name||u.username)}</b><br>
   <span class="small">@${escapeHTML(u.username)}</span></div>
  </div>
  <button class="primary" onclick="openChat('${u.id}','${escapeHTML(u.full_name||u.username)}')">Chat</button>
 </div>`).join("");
}

async function acceptRequest(id){
 const {error}=await supabaseClient.from("friendships")
   .update({status:"accepted"})
   .eq("requester_id",id).eq("addressee_id",currentUser.id);
 if(error)alert(error.message);else loadFriends();
}

async function rejectRequest(id){
 const {error}=await supabaseClient.from("friendships")
   .update({status:"rejected"})
   .eq("requester_id",id).eq("addressee_id",currentUser.id);
 if(error)alert(error.message);else loadFriends();
}

async function openChat(id,name){
 chatUser={id,name};
 $("chatName").textContent=name;
 show("chat");
 await loadMessages();
 subscribeMessages();
}

async function loadMessages(){
 const {data,error}=await supabaseClient.from("messages").select("*")
   .or("and(sender_id.eq."+currentUser.id+",receiver_id.eq."+chatUser.id+"),and(sender_id.eq."+chatUser.id+",receiver_id.eq."+currentUser.id+")")
   .order("created_at",{ascending:true});

 if(error){
   $("chatBox").innerHTML='<div class="msg err">'+escapeHTML(error.message)+'</div>';
   return;
 }
 renderMessages(data||[]);
}

function renderMessages(data){
 $("chatBox").innerHTML=data.map(m=>{
   const media=m.image_url ? (m.image_url.match(/\.(mp4|webm|mov)(\?|$)/i)
     ? `<video class="chat-media" controls src="${escapeHTML(m.image_url)}"></video>`
     : `<img class="chat-media" src="${escapeHTML(m.image_url)}" alt="Shared photo">`) : "";
   return `<div class="bubble ${m.sender_id===currentUser.id?"mine":"theirs"}">
    ${escapeHTML(m.message||"")}${media}
   </div>`;
 }).join("");
 $("chatBox").scrollTop=$("chatBox").scrollHeight;
}

function previewMedia(){
 const file=$("mediaInput").files[0];
 $("mediaName").textContent=file?file.name:"No file selected";
 $("mediaPreview").innerHTML="";
 if(!file)return;
 const url=URL.createObjectURL(file);
 $("mediaPreview").innerHTML=file.type.startsWith("video/")
   ? `<video class="media-preview" controls src="${url}"></video>`
   : `<img class="media-preview" src="${url}" alt="Preview">`;
}

async function uploadChatMedia(file){
 const safeName=file.name.replace(/[^a-zA-Z0-9._-]/g,"_");
 const path=currentUser.id+"/"+Date.now()+"_"+safeName;
 const {error}=await supabaseClient.storage.from("chat-media").upload(path,file,{
   cacheControl:"3600",upsert:false
 });
 if(error)throw error;
 const {data}=supabaseClient.storage.from("chat-media").getPublicUrl(path);
 return data.publicUrl;
}

async function sendMessage(){
 const input=$("messageInput");
 const fileInput=$("mediaInput");
 const text=input.value.trim();
 const file=fileInput.files[0];
 if((!text&&!file)||!chatUser)return;

 try{
   let image_url=null;
   if(file) image_url=await uploadChatMedia(file);
   const {error}=await supabaseClient.from("messages").insert({
     sender_id:currentUser.id,receiver_id:chatUser.id,message:text||null,image_url
   });
   if(error)throw error;
   input.value="";
   fileInput.value="";
   $("mediaName").textContent="No file selected";
   $("mediaPreview").innerHTML="";
   await loadMessages();
 }catch(error){
   alert("Media/message send failed: "+error.message);
 }
}

\nlet postMediaPreviewURL=null;\n\nfunction previewPostMedia(){\n const file=$("postMedia").files[0];\n $("postMediaName").textContent=file?file.name:"No file selected";\n $("postPreview").innerHTML="";\n if(postMediaPreviewURL)URL.revokeObjectURL(postMediaPreviewURL);\n if(!file)return;\n postMediaPreviewURL=URL.createObjectURL(file);\n $("postPreview").innerHTML=file.type.startsWith("video/")\n   ? `<video class="media-preview" controls src="${postMediaPreviewURL}"></video>`\n   : `<img class="media-preview" src="${postMediaPreviewURL}" alt="Preview">`;\n}\n\nasync function uploadPostMedia(file){\n const safeName=file.name.replace(/[^a-zA-Z0-9._-]/g,"_");\n const path=currentUser.id+"/"+Date.now()+"_"+safeName;\n const {error}=await supabaseClient.storage.from("post-media").upload(path,file,{cacheControl:"3600",upsert:false});\n if(error)throw error;\n const {data}=supabaseClient.storage.from("post-media").getPublicUrl(path);\n return data.publicUrl;\n}\n\nasync function createPost(){\n const text=$("postText").value.trim();\n const file=$("postMedia").files[0];\n if(!text&&!file){alert("Write something or choose a photo/video.");return}\n try{\n   let media_url=null,media_type=null;\n   if(file){media_url=await uploadPostMedia(file);media_type=file.type.startsWith("video/")?"video":"image"}\n   const {error}=await supabaseClient.from("posts").insert({user_id:currentUser.id,content:text||null,media_url,media_type});\n   if(error)throw error;\n   $("postText").value="";$("postMedia").value="";$("postMediaName").textContent="No file selected";$("postPreview").innerHTML="";\n   await loadPosts();\n }catch(e){alert("Post failed: "+e.message)}\n}\n\nasync function loadPosts(){\n const {data:posts,error}=await supabaseClient.from("posts").select("*").order("created_at",{ascending:false}).limit(50);\n if(error){$("postsFeed").innerHTML='<div class="msg err">'+escapeHTML(error.message)+'</div>';return}\n if(!posts?.length){$("postsFeed").innerHTML='<div class="msg">No posts yet. Be the first to post! ❤️</div>';return}\n const ids=[...new Set(posts.map(p=>p.user_id))];\n const {data:users}=await supabaseClient.from("profiles").select("id,username,full_name").in("id",ids);\n const map={};(users||[]).forEach(u=>map[u.id]=u);\n const postIds=posts.map(p=>p.id);\n const {data:likes}=await supabaseClient.from("post_likes").select("post_id,user_id").in("post_id",postIds);\n const {data:comments}=await supabaseClient.from("post_comments").select("id,post_id,user_id,comment,created_at").in("post_id",postIds).order("created_at",{ascending:true});\n const commentUserIds=[...new Set((comments||[]).map(c=>c.user_id))];\n const {data:commentUsers}=commentUserIds.length?await supabaseClient.from("profiles").select("id,username,full_name").in("id",commentUserIds):{data:[]};\n const cmap={};(commentUsers||[]).forEach(u=>cmap[u.id]=u);\n $("postsFeed").innerHTML=posts.map(p=>{\n   const u=map[p.user_id]||{};\n   const initials=(u.full_name||u.username||"?")[0].toUpperCase();\n   const pl=(likes||[]).filter(x=>x.post_id===p.id);\n   const liked=pl.some(x=>x.user_id===currentUser.id);\n   const pc=(comments||[]).filter(x=>x.post_id===p.id);\n   let media="";\n   if(p.media_url) media=p.media_type==="video"?`<video class="post-media" controls src="${escapeHTML(p.media_url)}"></video>`:`<img class="post-media" src="${escapeHTML(p.media_url)}" alt="Post photo">`;\n   const cls=p.user_id===currentUser.id?'':' hidden';\n   return `<article class="post" id="post-${p.id}">\n    <div class="post-head"><div class="post-avatar">${escapeHTML(initials)}</div><div><b>${escapeHTML(u.full_name||u.username||"Gitalk User")}</b><br><span class="small">@${escapeHTML(u.username||"")} · ${new Date(p.created_at).toLocaleString()}</span></div></div>\n    ${p.content?`<div style="margin-top:10px;white-space:pre-wrap">${escapeHTML(p.content)}</div>`:""}\n    ${media}\n    <div class="post-actions">\n      <button onclick="toggleLike(${p.id})">${liked?'❤️ Unlike':'🤍 Like'} (${pl.length})</button>\n      <button onclick="focusComment(${p.id})">💬 Comment (${pc.length})</button>\n      <button onclick="sharePost(${p.id})">🔄 Share</button>\n      <button class="${cls}" onclick="deletePost(${p.id})">🗑️ Delete</button>\n    </div>\n    <div class="comments">${pc.map(c=>{const cu=cmap[c.user_id]||{};return `<div class="comment"><b>${escapeHTML(cu.full_name||cu.username||"User")}</b>: ${escapeHTML(c.comment)}</div>`}).join("")}</div>\n    <div class="comment-box"><input id="comment-${p.id}" placeholder="Write a comment..."><button class="primary" onclick="addComment(${p.id})">Send</button></div>\n   </article>`;\n }).join("");\n}\n\nfunction focusComment(id){const el=$("comment-"+id);if(el){el.focus();el.scrollIntoView({behavior:"smooth",block:"center"})}}\n\nasync function toggleLike(postId){\n const {data:existing}=await supabaseClient.from("post_likes").select("id").eq("post_id",postId).eq("user_id",currentUser.id).maybeSingle();\n if(existing) await supabaseClient.from("post_likes").delete().eq("id",existing.id);\n else await supabaseClient.from("post_likes").insert({post_id:postId,user_id:currentUser.id});\n await loadPosts();\n}\n\nasync function addComment(postId){\n const input=$("comment-"+postId);const text=input.value.trim();if(!text)return;\n const {error}=await supabaseClient.from("post_comments").insert({post_id:postId,user_id:currentUser.id,comment:text});\n if(error)alert(error.message);else{input.value="";await loadPosts()}\n}\n\nasync function deletePost(postId){\n if(!confirm("Delete this post?"))return;\n const {error}=await supabaseClient.from("posts").delete().eq("id",postId).eq("user_id",currentUser.id);\n if(error)alert(error.message);else loadPosts();\n}\n\nasync function sharePost(postId){\n const url=location.href.split('#')[0]+"#post-"+postId;\n try{await navigator.clipboard.writeText(url);alert("Post link copied ❤️")}catch(e){prompt("Copy this post link:",url)}\n}\n\nfunction subscribeMessages(){
 if(chatChannel)supabaseClient.removeChannel(chatChannel);

 chatChannel=supabaseClient.channel(
   "gitalk-chat-"+currentUser.id+"-"+chatUser.id
 ).on("postgres_changes",{
   event:"INSERT",schema:"public",table:"messages"
 },payload=>{
   const m=payload.new;
   if((m.sender_id===currentUser.id&&m.receiver_id===chatUser.id) ||
      (m.sender_id===chatUser.id&&m.receiver_id===currentUser.id)){
     loadMessages();
   }
 }).subscribe();
}

function show(section){
 ["home","profile","search","friends","posts","chat"].forEach(x=>$(x).classList.add("hidden"));
 $(section).classList.remove("hidden");
 if(section==="friends")loadFriends();
}

async function logout(){
 if(chatChannel){
   await supabaseClient.removeChannel(chatChannel);
   chatChannel=null;
 }
 await supabaseClient.auth.signOut();
 currentUser=null;currentProfile=null;chatUser=null;
 $("app").classList.add("hidden");
 $("auth").classList.remove("hidden");
 $("loginPassword").value="";
}

supabaseClient.auth.getSession().then(({data})=>{
 if(data.session){
   currentUser=data.session.user;
   loadSession();
 }
});
